    "import time\n",
    "from importlib import import_module\n",
    "def calc(*, mod:str):\n",
    "    s = time.time()\n",
    "    import_module(mod)\n",
    "    end = time.time()\n",
    "    print(end-s)\n",
    "mod = \"vector_store.chroma_client\"\n",
    "calc(mod=mod)"
   ]
  }
